<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>JKRuntime</RootNamespace>
    <AssemblyName>JKRuntime</AssemblyName>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <LangVersion>5</LangVersion>
    <Optimize>true</Optimize>
    <OutputPath>..\..\build\jk-runtime\UPLOAD_TO_WORKSHOP\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="JumpKing"><HintPath>$(JumpKingDir)\JumpKing.exe</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoGame.Framework"><HintPath>$(JumpKingDir)\MonoGame.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LanguageJK"><HintPath>$(JumpKingDir)\LanguageJK.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Xml" /><Reference Include="System.Xml.Linq" /><Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup><Compile Include="src\**\*.cs" /></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
